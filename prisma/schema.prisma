datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  credits   Int      @default(100)
  plan      String   @default("free") // free | basic | pro | team
  dailyTaskCount Int @default(0)
  dailyResetDate String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id            String      @id @default(cuid())
  type          String      // ppt | website | video | email | proposal | unknown
  status        String      @default("pending")
  title         String      @default("")
  input         String
  context       String      @default("{}")
  currentStep   String      @default("init")
  result        String?
  errorMessage  String?
  source        String      @default("agent")
  estimatedCost Int         @default(0)
  actualCost    Int         @default(0)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        TaskEvent[]
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  data      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}
