datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  credits   Int      @default(100)
  plan      String   @default("free") // free | basic | pro | team
  dailyTaskCount Int @default(0)
  dailyResetDate String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id            String      @id @default(cuid())
  type          String      // ppt | website | video | email | proposal | unknown
  status        String      @default("pending")
  title         String      @default("")
  input         String
  context       String      @default("{}")
  currentStep   String      @default("init")
  result        String?
  errorMessage  String?
  source        String      @default("agent")
  estimatedCost Int         @default(0)
  actualCost    Int         @default(0)
  charged       Boolean     @default(false)
  cost          Int         @default(0)
  processing    Boolean     @default(false)
  isExecuting   Boolean     @default(false)
  priority      Int         @default(0)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        TaskEvent[]
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  data      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model AutoTask {
  id        String   @id @default(cuid())
  userId    String
  type      String   // ppt | email | proposal | etc.
  input     String
  schedule  String   // cron expression (e.g. "0 9 * * *")
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  amount    Int      // price in cents (e.g. 500 = $5)
  credits   Int      // credits to add on payment
  status    String   @default("pending") // pending | paid | failed
  provider  String   @default("") // wechat | alipay | paypal | mock
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
