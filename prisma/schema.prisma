datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  credits        Int      @default(100)
  plan           String   @default("free") // free | basic | pro | team
  expireAt       DateTime?
  dailyTaskCount Int      @default(0)
  dailyResetDate String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tasks          Task[]
  orders         Order[]
}

model Task {
  id            String      @id @default(cuid())
  type          String      // ppt | website | video | email | proposal | unknown
  status        String      @default("pending")
  title         String      @default("")
  input         String
  context       String      @default("{}")
  currentStep   String      @default("init")
  result        String?
  errorMessage  String?
  source        String      @default("agent")
  estimatedCost Int         @default(0)
  actualCost    Int         @default(0)
  charged       Boolean     @default(false)
  cost          Int         @default(0)
  processing    Boolean     @default(false)
  isExecuting   Boolean     @default(false)
  priority      Int         @default(0)
  assigneeId     String?
  businessStatus String  @default("assigned")
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        TaskEvent[]
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  data      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model AutoTask {
  id        String   @id @default(cuid())
  userId    String
  type      String   // ppt | email | proposal | etc.
  input     String
  schedule  String   // cron expression (e.g. "0 9 * * *")
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
}

model ScheduledTask {
  id           String   @id @default(cuid())
  type         String   // ppt | email | proposal | unknown
  input        String
  cron         String   // "daily" | "weekly"
  nextRunAt    DateTime
  userId       String
  enabled      Boolean  @default(true)
  autoRunCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  productType     String    // subscription | credits
  productCode     String    // basic_monthly | pro_monthly | team_monthly | credits_100 | credits_500 | credits_2000
  amount          Int       // price in fen (cents CNY)
  currency        String    @default("CNY")
  credits         Int       @default(0) // credits to add
  status          String    @default("pending") // pending | paid | failed | cancelled
  provider        String    @default("wechat")
  providerOrderId String?
  providerPayload String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([providerOrderId])
  @@index([userId, status])
}
