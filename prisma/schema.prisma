datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  email          String?  @unique
  emailVerified  Boolean  @default(false)
  passwordHash   String?
  googleId       String?  @unique
  name           String?
  avatarUrl      String?
  credits        Int      @default(100)
  plan           String   @default("free")
  expireAt       DateTime?
  dailyTaskCount Int      @default(0)
  dailyResetDate String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tasks          Task[]
  orders         Order[]
  sessions       Session[]
  verificationCodes VerificationCode[]
  teamMemberships   TeamMember[]
  ownedTeams        Team[]   @relation("TeamOwner")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([token])
  @@index([userId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([email, code])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  ownerId     String
  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id])
  inviteCode  String       @unique @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  @@unique([teamId, userId])
  @@index([userId])
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
  @@index([userId, createdAt])
}

model Task {
  id            String      @id @default(cuid())
  type          String
  status        String      @default("pending")
  title         String      @default("")
  input         String
  context       String      @default("{}")
  currentStep   String      @default("init")
  result        String?
  errorMessage  String?
  source        String      @default("agent")
  estimatedCost Int         @default(0)
  actualCost    Int         @default(0)
  charged       Boolean     @default(false)
  cost          Int         @default(0)
  processing    Boolean     @default(false)
  isExecuting   Boolean     @default(false)
  priority      Int         @default(0)
  assigneeId    String?
  businessStatus String     @default("assigned")
  externalJobId  String?
  externalEngine String?
  conversationId String?
  conversation  Conversation? @relation(fields: [conversationId], references: [id])
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  teamId        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  events        TaskEvent[]
  @@index([conversationId])
  @@index([userId, createdAt])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  data      String
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}

model AutoTask {
  id        String   @id @default(cuid())
  userId    String
  type      String
  input     String
  schedule  String
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
}

model ScheduledTask {
  id           String   @id @default(cuid())
  type         String
  input        String
  cron         String
  nextRunAt    DateTime
  userId       String
  enabled      Boolean  @default(true)
  autoRunCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  productType     String
  productCode     String
  amount          Int
  currency        String    @default("CNY")
  credits         Int       @default(0)
  status          String    @default("pending")
  provider        String    @default("wechat")
  providerOrderId String?
  providerPayload String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([providerOrderId])
  @@index([userId, status])
}
