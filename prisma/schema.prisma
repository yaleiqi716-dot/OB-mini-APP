datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  email          String?  @unique
  emailVerified  Boolean  @default(false)
  passwordHash   String?
  googleId       String?  @unique
  name           String?
  avatarUrl      String?
  credits        Int      @default(100)
  plan           String   @default("free")
  expireAt       DateTime?
  dailyTaskCount Int      @default(0)
  dailyResetDate String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tasks          Task[]
  orders         Order[]
  sessions       Session[]
  verificationCodes VerificationCode[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]      @relation("WorkspaceOwner")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([token])
  @@index([userId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([email, code])
}


model Conversation {
  id          String     @id @default(uuid())
  userId      String
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  title       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tasks       Task[]
  @@index([userId, createdAt])
  @@index([workspaceId])
}

model Task {
  id            String      @id @default(cuid())
  type          String
  status        String      @default("pending")
  title         String      @default("")
  input         String
  context       String      @default("{}")
  currentStep   String      @default("init")
  result        String?
  errorMessage  String?
  source        String      @default("agent")
  estimatedCost Int         @default(0)
  actualCost    Int         @default(0)
  charged       Boolean     @default(false)
  cost          Int         @default(0)
  processing    Boolean     @default(false)
  isExecuting   Boolean     @default(false)
  priority      Int         @default(0)
  assigneeId    String?
  businessStatus String     @default("assigned")
  externalJobId  String?
  externalEngine String?
  conversationId   String?
  conversation     Conversation?  @relation(fields: [conversationId], references: [id])
  userId           String?
  user             User?          @relation(fields: [userId], references: [id])
  teamId           String?
  workspaceTaskId  String?
  workspaceTask    WorkspaceTask? @relation(fields: [workspaceTaskId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  events           TaskEvent[]
  @@index([conversationId])
  @@index([userId, createdAt])
  @@index([workspaceTaskId])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String
  data      String
  createdAt DateTime @default(now())
  @@index([taskId, createdAt])
}

model AutoTask {
  id        String   @id @default(cuid())
  userId    String
  type      String
  input     String
  schedule  String
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
}

model ScheduledTask {
  id           String   @id @default(cuid())
  type         String
  input        String
  cron         String
  nextRunAt    DateTime
  userId       String
  enabled      Boolean  @default(true)
  autoRunCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  productType     String
  productCode     String
  amount          Int
  currency        String    @default("CNY")
  credits         Int       @default(0)
  status          String    @default("pending")
  provider        String    @default("wechat")
  providerOrderId String?
  providerPayload String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([providerOrderId])
  @@index([userId, status])
}


// ═══════════════════════════════════════════════════════════════
// WORKSPACE MODELS — Team Task Flow MVP v1.0
// ═══════════════════════════════════════════════════════════════

model Workspace {
  id              String             @id @default(cuid())
  name            String
  ownerId         String
  owner           User               @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  wecomWebhookUrl String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  tasks           WorkspaceTask[]
  conversations   Conversation[]
  @@index([ownerId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  status      String    @default("active")
  invitedAt   DateTime  @default(now())
  joinedAt    DateTime?
  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email          String
  role           String    @default("member")
  invitedBy      String
  token          String    @unique
  status         String    @default("pending")
  expiresAt      DateTime
  acceptedUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([token])
  @@index([workspaceId, email])
  @@index([email, status])
}

model WorkspaceTask {
  id                String              @id @default(cuid())
  workspaceId       String
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  businessStatus    String              @default("draft")
  priority          Int                 @default(0)
  createdBy         String
  assigneeId        String?
  dueAt             DateTime?
  feedback          String?
  submissionSummary       String?
  attachments             String?   // JSON: [{id,name,size,type,url,uploadedBy,uploadedAt}]
  submissionAttachments   String?   // JSON: same structure
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  links             WorkspaceTaskLink[]
  agentTasks        Task[]
  comments          WorkspaceTaskComment[]
  @@index([workspaceId, businessStatus])
  @@index([assigneeId, businessStatus])
  @@index([createdBy])
}

model WorkspaceTaskLink {
  id              String        @id @default(cuid())
  workspaceTaskId String
  workspaceTask   WorkspaceTask @relation(fields: [workspaceTaskId], references: [id], onDelete: Cascade)
  agentTaskId     String
  conversationId  String?
  purpose         String        @default("draft")
  submittedAt     DateTime?
  createdAt       DateTime      @default(now())
  @@index([workspaceTaskId])
  @@index([agentTaskId])
}

model WorkspaceTaskComment {
  id              String        @id @default(cuid())
  workspaceTaskId String
  workspaceTask   WorkspaceTask @relation(fields: [workspaceTaskId], references: [id], onDelete: Cascade)
  userId          String
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([workspaceTaskId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // task_assigned | task_submitted | task_revision | task_completed | invite_received
  title     String
  body      String?
  linkUrl   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, read, createdAt])
}
